# ─────────────────────────────────────────────────────────────────────────
# EasyShop AI environment variables — TEMPLATE
#
# Copy this file to `.env` (or run `make setup`) and adjust as needed:
#
#     cp .env.example .env
#
# Docker Compose loads `.env` automatically. `.env` is gitignored — never
# commit real secrets (the original EasyShop repo this project is inspired
# by committed a real-looking JWT_SECRET; don't repeat that here).
# ─────────────────────────────────────────────────────────────────────────

# --- Postgres ---
POSTGRES_USER=easyshop
POSTGRES_PASSWORD=easyshop
POSTGRES_DB=easyshop
DATABASE_URL=postgres://easyshop:easyshop@postgres:5432/easyshop

# --- Auth ---
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# --- AI (Anthropic) ---
# Required for the four AI features (search, shopping assistant, product
# descriptions, recommendations). If unset, the app still runs fully — AI
# endpoints return a clear 503 "not configured" response instead of crashing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_SECONDS=20

# --- Host port mappings ---
APP_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
